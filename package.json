{
  "name": "atlas",
  "version": "0.2.19",
  "private": true,
  "description": "Deterministic 2D city map generator: seed plus params to a typed city blueprint",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "preview": "vite",
    "build": "tsc --noEmit",
    "generate": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.mjs --log-level=warning && node dist/cli.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "happy-dom": "^20.12.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@types/three": "^0.185.0",
    "clipper2-ts": "^2.0.1-18",
    "three": "^0.185.1"
  }
}
