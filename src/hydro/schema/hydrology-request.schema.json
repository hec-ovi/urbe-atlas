{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:atlas:hydro:request",
  "type": "object",
  "additionalProperties": false,
  "required": ["seed", "size", "boundary"],
  "properties": {
    "seed": { "type": ["string", "number"] },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "boundary": { "$ref": "#/$defs/polygon" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "enum": ["lagoon", "river", "sea-coast"] } }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false
    },
    "polygon": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } }
  }
}
