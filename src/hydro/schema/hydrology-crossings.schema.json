{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:atlas:hydro:crossings",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["network", "refId", "path", "width", "level"],
    "properties": {
      "network": { "enum": ["street", "train", "subway"] },
      "refId": { "type": "string", "minLength": 1 },
      "path": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "array",
          "minItems": 2,
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "items": false
        }
      },
      "width": { "type": "number", "exclusiveMinimum": 0 },
      "level": { "type": "number" },
      "corridor": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "items": false
          }
        }
      }
    }
  }
}
