{
  "id": "creation",
  "title": "Create a city",
  "layout": {"type": "split", "ratio": [70, 30], "items": ["form", "cities"]},
  "values": {
    "seed": "urbe",
    "size": {"width": 1000, "depth": 1000},
    "irregularity": 0,
    "footprintShape": "rectangle",
    "districtCount": [1, 3],
    "maxFloors": 40,
    "tierWeights": {"poor": 0.3, "mid": 0.45, "rich": 0.2, "high_rich": 0.05},
    "features": {"highways": true, "subways": true, "alleys": true, "airTunnels": true, "undergroundTunnels": true},
    "streetDesign": {
      "moduleFormat": "district",
      "profiles": [
        {"id": "one-way", "classes": ["street"], "lanes": [{"direction": "forward", "width": 4}], "shoulders": {"left": 0, "right": 0}},
        {"id": "local", "classes": ["street"], "lanes": [{"direction": "backward", "width": 3.5}, {"direction": "forward", "width": 3.5}], "shoulders": {"left": 0, "right": 0}},
        {
          "id": "avenue",
          "classes": ["road"],
          "lanes": [{"direction": "backward", "width": 3.5}, {"direction": "backward", "width": 3.5}, {"direction": "forward", "width": 3.5}, {"direction": "forward", "width": 3.5}],
          "shoulders": {"left": 0, "right": 0}
        }
      ],
      "sidewalkProfiles": [
        {
          "id": "district",
          "curb": 0.2,
          "border": 1,
          "furnishing": 1,
          "walking": 2,
          "frontage": 0.2,
          "edge": {"curbRise": 0.2, "gutter": {"width": 0.5, "lip": {"width": 0.02, "height": 0.02, "side": "road"}}}
        }
      ],
      "crossings": {"pedestrianClearance": 2.5}
    },
    "pavingDesign": {
      "defaultLayoutId": "metre-slabs",
      "districtLayouts": [],
      "layouts": [
        {
          "id": "metre-slabs",
          "familyId": "maintained",
          "modules": [
            {"id": "slab", "pitch": [1, 1], "joint": [0.012, 0.012]},
            {"id": "double-slab", "pitch": [2, 2], "joint": [0.012, 0.012], "baseCells": [2, 2]},
            {"id": "curb", "pitch": [1, 0.2], "joint": [0.012, 0]},
            {"id": "border", "pitch": [1, 1], "joint": [0.012, 0]}
          ],
          "bands": {
            "curb": {"moduleId": "curb", "borderWidth": 0},
            "border": {"moduleId": "border", "borderWidth": 0},
            "furnishing": {"moduleId": "slab", "borderWidth": 0},
            "walking": {"moduleId": "slab", "borderWidth": 0, "grouping": {"moduleId": "double-slab", "period": [4, 2], "offset": [0, 0]}},
            "frontage": {"moduleId": "slab", "borderWidth": 0}
          }
        }
      ]
    }
  },
  "form": [
    {"type": "heading", "eyebrow": "Deterministic blueprint", "text": "Create a city", "description": "Choose a template, then adjust your city."},
    {
      "type": "presets",
      "items": [
        {
          "id": "compact",
          "label": "Compact",
          "keep": ["seed"],
          "values": {
            "size": {"width": 600, "depth": 600},
            "irregularity": 0,
            "districtCount": [1, 2],
            "maxFloors": 8,
            "footprintShape": "rectangle",
            "tierWeights": {"poor": 0.3, "mid": 0.45, "rich": 0.2, "high_rich": 0.05},
            "features": {"highways": false, "subways": false, "alleys": true, "airTunnels": true, "undergroundTunnels": true}
          }
        },
        {
          "id": "city",
          "label": "City",
          "keep": ["seed"],
          "values": {
            "size": {"width": 1000, "depth": 1000},
            "irregularity": 0,
            "districtCount": [1, 3],
            "maxFloors": 40,
            "footprintShape": "rectangle",
            "tierWeights": {"poor": 0.3, "mid": 0.45, "rich": 0.2, "high_rich": 0.05},
            "features": {"highways": true, "subways": true, "alleys": true, "airTunnels": true, "undergroundTunnels": true}
          }
        },
        {
          "id": "metro",
          "label": "Metro",
          "keep": ["seed"],
          "values": {
            "size": {"width": 3000, "depth": 3000},
            "irregularity": 0,
            "districtCount": [4, 8],
            "maxFloors": 60,
            "footprintShape": "rectangle",
            "tierWeights": {"poor": 0.3, "mid": 0.45, "rich": 0.2, "high_rich": 0.05},
            "features": {"highways": true, "subways": true, "alleys": true, "airTunnels": true, "undergroundTunnels": true}
          }
        }
      ],
      "label": "Template",
      "id": "template"
    },
    {
      "type": "section",
      "title": "Identity",
      "items": [
        {
          "type": "action-row",
          "items": [{"type": "text", "id": "seed", "path": "seed", "label": "Seed", "required": true}, {"type": "action", "id": "random-seed", "label": "Random seed"}]
        }
      ]
    },
    {
      "type": "section",
      "title": "City shape",
      "columns": 2,
      "items": [
        {"type": "slider", "id": "width", "path": "size.width", "label": "Width", "min": 300, "max": 5000, "exactMin": 1, "step": 100},
        {"type": "slider", "id": "depth", "path": "size.depth", "label": "Depth", "min": 300, "max": 5000, "exactMin": 1, "step": 100},
        {
          "type": "select",
          "id": "footprint-shape",
          "path": "footprintShape",
          "label": "Building footprint",
          "options": [{"value": "rectangle", "label": "Rectangle"}, {"value": "parcel", "label": "Follow parcel"}]
        },
        {
          "type": "select",
          "id": "hydrology",
          "path": "hydrology.type",
          "label": "Waterfront",
          "empty": "none",
          "options": [{"value": "none", "label": "None"}, {"value": "lagoon", "label": "Lagoon"}, {"value": "river", "label": "River"}, {"value": "sea-coast", "label": "Sea coast"}]
        }
      ]
    },
    {
      "type": "section",
      "title": "Streets",
      "items": [
        {"type": "note", "text": "Every third row and column of the grid is an avenue; the rest are streets, and the seed picks which of the two street profiles each one takes. Lane counts come with the class: 1 or 2 lanes for a street, 4 for an avenue. Defaults give 4, 7 and 14 m of carriageway."},
        {
          "type": "grid",
          "columns": 2,
          "items": [
            {"type": "slider", "id": "lane-narrow-street", "path": "streetDesign.profiles.0.lanes.0.width", "label": "Narrow street, 1 lane", "min": 3, "max": 8, "step": 0.2, "multipleOf": 0.2, "unit": "m"},
            {
              "type": "slider", "id": "lane-street", "label": "Wide street, 2 lanes", "min": 2.5, "max": 6, "step": 0.1, "multipleOf": 0.1, "unit": "m",
              "paths": ["streetDesign.profiles.1.lanes.0.width", "streetDesign.profiles.1.lanes.1.width"]
            },
            {
              "type": "slider", "id": "lane-avenue", "label": "Avenue, 4 lanes", "min": 2.5, "max": 3.5, "step": 0.1, "multipleOf": 0.1, "unit": "m",
              "paths": [
                "streetDesign.profiles.2.lanes.0.width", "streetDesign.profiles.2.lanes.1.width",
                "streetDesign.profiles.2.lanes.2.width", "streetDesign.profiles.2.lanes.3.width"
              ]
            }
          ]
        },
        {"type": "note", "text": "Avenue lanes stop at 3.5 m. Where the highway deck crosses an avenue it spans the whole street between two columns, and 30 m is all one deck span gets."},
        {"type": "note", "text": "Each side of a street reserves 4.2 m of paving, divided into four bands starting at the curb. A 0.2 m curb and a 0.5 m gutter sit outside it; both are fixed by the district paving modules, as is the 4.2 m total."},
        {
          "type": "grid",
          "columns": 2,
          "total": {
            "equals": 4.2,
            "message": "The four sidewalk bands must add up to 4.2 m of paving.",
            "paths": [
              "streetDesign.sidewalkProfiles.0.border", "streetDesign.sidewalkProfiles.0.furnishing",
              "streetDesign.sidewalkProfiles.0.walking", "streetDesign.sidewalkProfiles.0.frontage"
            ]
          },
          "items": [
            {"type": "slider", "id": "band-border", "path": "streetDesign.sidewalkProfiles.0.border", "label": "Curb border", "min": 0, "max": 4, "step": 0.1, "unit": "m"},
            {"type": "slider", "id": "band-furnishing", "path": "streetDesign.sidewalkProfiles.0.furnishing", "label": "Furnishing", "min": 0, "max": 4, "step": 0.1, "unit": "m", "description": "Trees, lamp posts and bins stand in this band."},
            {"type": "slider", "id": "band-walking", "path": "streetDesign.sidewalkProfiles.0.walking", "label": "Walking", "min": 0.2, "max": 4.2, "step": 0.1, "unit": "m", "description": "Where people walk and where crossings land."},
            {"type": "slider", "id": "band-frontage", "path": "streetDesign.sidewalkProfiles.0.frontage", "label": "Frontage", "min": 0, "max": 2, "step": 0.1, "unit": "m", "description": "Separator against the building line."}
          ]
        },
        {
          "type": "grid",
          "columns": 2,
          "items": [
            {"type": "slider", "id": "crossing-clearance", "path": "streetDesign.crossings.pedestrianClearance", "label": "Crossing headroom", "min": 1.5, "max": 6, "step": 0.1, "unit": "m", "description": "Height a crossing needs. Under a highway deck, an arm that cannot get it carries no crossing."},
            {
              "type": "select", "id": "paving-finish", "path": "pavingDesign.layouts.0.familyId", "label": "Paving finish",
              "options": [
                {"value": "maintained", "label": "Maintained"},
                {"value": "ordinary", "label": "Ordinary"},
                {"value": "luxury-blue", "label": "Luxury blue"},
                {"value": "luxury-red", "label": "Luxury red"},
                {"value": "industrial-yellow", "label": "Industrial yellow"}
              ]
            }
          ]
        },
        {"type": "note", "text": "The finish is one identifier for the whole city; Materials resolves the texture. Panel pitches and joints travel with the saved parameters, and generation takes its dimensions from the district module catalog instead."}
      ]
    },
    {
      "type": "section",
      "title": "Districts",
      "columns": 2,
      "items": [
        {"type": "slider", "id": "district-min", "path": "districtCount.0", "label": "Minimum districts", "min": 1, "max": 24, "step": 1, "integer": true},
        {"type": "slider", "id": "district-max", "path": "districtCount.1", "label": "Maximum districts", "min": 1, "max": 24, "step": 1, "integer": true},
        {"type": "note", "text": "Each district needs at least 90,000 m²."}
      ]
    },
    {
      "type": "section",
      "title": "Building height",
      "items": [
        {"type": "slider", "id": "maxFloors", "path": "maxFloors", "label": "Global floor cap", "min": 1, "max": 120, "step": 1, "integer": true},
        {"type": "note", "text": "Optional district caps override the global limit."},
        {
          "type": "grid",
          "columns": 2,
          "items": [
            {"type": "optional-number", "id": "cap-downtown", "path": "maxFloorsByDistrict.downtown", "label": "downtown", "min": 1, "step": 1, "integer": true},
            {"type": "optional-number", "id": "cap-commercial", "path": "maxFloorsByDistrict.commercial", "label": "commercial", "min": 1, "step": 1, "integer": true},
            {"type": "optional-number", "id": "cap-residential", "path": "maxFloorsByDistrict.residential", "label": "residential", "min": 1, "step": 1, "integer": true},
            {"type": "optional-number", "id": "cap-industrial", "path": "maxFloorsByDistrict.industrial", "label": "industrial", "min": 1, "step": 1, "integer": true},
            {"type": "optional-number", "id": "cap-mixed", "path": "maxFloorsByDistrict.mixed", "label": "mixed", "min": 1, "step": 1, "integer": true}
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "Wealth distribution",
      "columns": 2,
      "items": [
        {"type": "note", "text": "Relative weights are normalized during generation."},
        {"type": "slider", "id": "tier-poor", "path": "tierWeights.poor", "label": "Poor weight", "min": 0, "max": 1, "step": 0.05},
        {"type": "slider", "id": "tier-mid", "path": "tierWeights.mid", "label": "Mid weight", "min": 0, "max": 1, "step": 0.05},
        {"type": "slider", "id": "tier-rich", "path": "tierWeights.rich", "label": "Rich weight", "min": 0, "max": 1, "step": 0.05},
        {"type": "slider", "id": "tier-high_rich", "path": "tierWeights.high_rich", "label": "High rich weight", "min": 0, "max": 1, "step": 0.05}
      ]
    },
    {
      "type": "section",
      "title": "Networks and connections",
      "columns": 2,
      "items": [
        {"type": "toggle", "id": "highways", "path": "features.highways", "label": "Highways", "description": "Elevated through-routes with ramps and supports"},
        {"type": "toggle", "id": "subways", "path": "features.subways", "label": "Subways", "description": "Underground lines, platforms and street entrances"},
        {"type": "toggle", "id": "alleys", "path": "features.alleys", "label": "Alleys", "description": "Pedestrian cuts through long and dense blocks"},
        {"type": "toggle", "id": "airTunnels", "path": "features.airTunnels", "label": "Air tunnels", "description": "Allow downstream bridges and overhead links"},
        {"type": "toggle", "id": "undergroundTunnels", "path": "features.undergroundTunnels", "label": "Underground tunnels", "description": "Allow downstream underground links"}
      ]
    },
    {"type": "action", "id": "generate", "label": "Generate city", "style": "primary"}
  ]
}
